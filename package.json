{
  "name": "newfreedeck",
  "version": "0.1.6",
  "description": "NewFreedeck decky plugin",
  "type": "module",
  "scripts": {
    "build": "rollup -c && node -e \"const{cpSync,mkdirSync}=require('fs');const s='defaults/emulator_assets',d='dist/emulator_icons';mkdirSync(d,{recursive:true});cpSync(s,d,{recursive:true})\"",
    "build:js": "rollup -c",
    "copy:icons": "node -e \"const{cpSync,mkdirSync}=require('fs');const s='defaults/emulator_assets',d='dist/emulator_icons';try{mkdirSync(d,{recursive:true});cpSync(s,d,{recursive:true})}catch(e){console.error('copy icons failed:',e.message)}\"",
    "watch": "rollup -c -w"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-gnu": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
